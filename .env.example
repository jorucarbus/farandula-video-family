# Google Drive - solo lectura (carpeta Famosos compartida)
# Necesita credentials.json (Service Account key) en la raíz del proyecto, NO se sube a git
GOOGLE_DRIVE_FOLDER_ID=your_famosos_folder_id_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/farandula_family

# Google Gemini (shared by all users)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for session tokens
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Node Environment
NODE_ENV=development

# Optional: Port (default 3000)
PORT=3000
